#!/bin/bash
# Arranque de la EC2: clona el repo, instala dependencias y levanta la API.
set -euxo pipefail
exec > >(tee /var/log/todo-api-bootstrap.log) 2>&1

dnf install -y git python3.11 python3.11-pip unzip

mkdir -p /opt/todo-api/releases
git clone ${repo_url} /opt/todo-api/releases/initial
ln -sfn /opt/todo-api/releases/initial /opt/todo-api/current

python3.11 -m venv /opt/todo-api/venv
/opt/todo-api/venv/bin/pip install --upgrade pip
/opt/todo-api/venv/bin/pip install -r /opt/todo-api/current/src/requirements.txt

cat > /etc/todo-api.env <<'EOF'
APP_VERSION=${app_version}
DB_SECRET_NAME=${db_secret_name}
AWS_REGION=${aws_region}
AWS_DEFAULT_REGION=${aws_region}
METRICS_ENABLED=true
EOF

cat > /etc/systemd/system/todo-api.service <<'EOF'
[Unit]
Description=to-do-list-api
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
EnvironmentFile=/etc/todo-api.env
WorkingDirectory=/opt/todo-api/current/src
ExecStart=/opt/todo-api/venv/bin/uvicorn main:app --host 0.0.0.0 --port ${app_port}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

chown -R ec2-user:ec2-user /opt/todo-api
systemctl daemon-reload
systemctl enable --now todo-api
